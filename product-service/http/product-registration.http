### 샘플 상품 등록 - 공급사/MD가 상품 마스터를 등록하는 상황을 흉내
# 게이트웨이에 라우팅하지 않은 관리 API이므로 product-service(8081)로 직접 호출
# SKU-0005는 입고 재시도 시나리오(상품 미등록 → 재시도 → 등록 후 성공)에 쓰기 위해 일부러 등록하지 않음
@baseUrl = http://localhost:8081

### 냉장 - 우유
POST {{baseUrl}}/api/admin/products
Content-Type: application/json

{
  "productCode": "SKU-0001",
  "name": "유기농 우유 900ml",
  "brand": "파크팜",
  "description": "1등급 원유로 만든 유기농 우유",
  "storageType": "REFRIGERATED",
  "price": 3900,
  "categoryId": 1
}

### 냉장 - 두부
POST {{baseUrl}}/api/admin/products
Content-Type: application/json

{
  "productCode": "SKU-0002",
  "name": "국산콩 두부 300g",
  "brand": "파크푸드",
  "description": "국산 콩 100%로 만든 부침용 두부",
  "storageType": "REFRIGERATED",
  "price": 2500,
  "categoryId": 1
}

### 냉동 - 만두
POST {{baseUrl}}/api/admin/products
Content-Type: application/json

{
  "productCode": "SKU-0003",
  "name": "고기 왕만두 1kg",
  "brand": "파크푸드",
  "description": "두툼한 고기소를 채운 냉동 왕만두",
  "storageType": "FROZEN",
  "price": 9900,
  "categoryId": 2
}

### 상온 - 라면
POST {{baseUrl}}/api/admin/products
Content-Type: application/json

{
  "productCode": "SKU-0004",
  "name": "얼큰 라면 5입",
  "brand": "파크라면",
  "storageType": "ROOM_TEMPERATURE",
  "price": 4500,
  "categoryId": 3
}

### 중복 등록 - 409 DUPLICATE_PRODUCT_CODE
POST {{baseUrl}}/api/admin/products
Content-Type: application/json

{
  "productCode": "SKU-0001",
  "name": "유기농 우유 900ml",
  "storageType": "REFRIGERATED",
  "price": 3900,
  "categoryId": 1
}
